.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.env

# Datasets are downloaded by scripts/fetch_data.py and never committed (see README: Data and licenses).
# data/gold/ holds hand labels only (ids, callsigns, values), no transcript text or audio.
data/raw/
# ATCO2 blind-test labels: ATCO2's terms forbid sharing derived data. The committed
# data/gold/atco2-blind.manifest.json holds their hash instead.
data/blind/

# Per-clip transcripts contain dataset text; only aggregate reports are committed
results/raw/

# Generated by scripts/make_scenarios.py (deterministic from the seed)
scenarios/
.claude/

# Training run state; status, log, checks and TRAINING.md are committed, the rest is local
training/logs/
training/champion.pt
training/*.tmp

# Fine-tuning data written by scripts/export_sft.py (regenerated from the seed)
data/sft/
